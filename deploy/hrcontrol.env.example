# /etc/hrcontrol/hrcontrol.env — сирҳои сервер (root:hrcontrol, 640)
# Роҳҳои база/log дар deploy/hrcontrol.service гузошта шудаанд.

BOT_TOKEN=
GROUP_ID=-1003933020249
WEBAPP_URL=https://test.softclub.tj/hrcontrol/

ADMIN_LOGIN=softclub
ADMIN_PASS=
# openssl rand -hex 32
SECRET_KEY=
# Telegram user_id-ҳое, ки бе рамз ба панел медароянд (ғайр аз админҳои гурӯҳ), бо вергул
ADMIN_IDS=

# Танҳо дохилӣ — аз берун тавассути nginx (https)
HTTP_HOST=127.0.0.1
HTTP_PORT=8901

TZ_NAME=Asia/Dushanbe
# Нусхаи ҳаррӯзаи база ба ин чат (ихтиёрӣ, 0 — хомӯш)
BACKUP_CHAT_ID=0
