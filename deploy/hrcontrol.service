[Unit]
Description=SoftClub HR Control — Telegram bot + admin panel
After=network-online.target
Wants=network-online.target
# Ҳеҷ гоҳ «аз ҳад зиёд restart» ҳисоб намешавад (бояд дар [Unit] бошад, на [Service])
StartLimitIntervalSec=0

[Service]
Type=simple
# Корбари системавии ҷудо — ба папкаҳои хона ва корбарони дигари сервер вобаста нест
User=hrcontrol
Group=hrcontrol
WorkingDirectory=/opt/hrcontrol
# Сирҳо (BOT_TOKEN, ADMIN_PASS, SECRET_KEY ...) — берун аз код
EnvironmentFile=/etc/hrcontrol/hrcontrol.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DB_PATH=/var/lib/hrcontrol/softclub.db
Environment=BACKUP_DIR=/var/lib/hrcontrol/backups
Environment=LOG_PATH=/var/lib/hrcontrol/bot.log
Environment=RESTORE_DIRS=/var/backups/hrcontrol/db
ExecStart=/opt/hrcontrol/.venv/bin/python3 main.py

# Ҳеҷ гоҳ намемирад: ҳар афтиш → аз нав (5с → … → то 60с, агар пай дар пай афтад)
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60

# Хомӯшшавии осоишта: main.py SIGTERM-ро мегирад ва дар ≤10 сония мебарояд
KillSignal=SIGTERM
TimeoutStopSec=30

# /var/lib/hrcontrol-ро systemd худаш месозад (ҳатто агар касе нест кунад)
StateDirectory=hrcontrol
StateDirectoryMode=0750
UMask=0027

# Муҳофизат: код ва система танҳо барои хондан, хона пӯшида
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Агар хотира «шорад» — systemd мекушад ва Restart=always аз нав мебардорад
MemoryMax=512M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hrcontrol

[Install]
WantedBy=multi-user.target
