# SoftClub / Hrcontrol — намунаи танзимот.
# Нусха бардоред ба `.env` ва қиматҳоро гузоред.
# `.env` набошад ҳам, бот бо қиматҳои пешфарз кор мекунад.

# ── Telegram ──
BOT_TOKEN=
GROUP_ID=-1003933020249
WEBAPP_URL=https://test.softclub.tj/hrcontrol/

# ── Панели маъмурият ──
ADMIN_LOGIN=softclub
ADMIN_PASS=
SECRET_KEY=иваз-кунед-ба-сатри-тасодуфии-дароз
HTTP_HOST=0.0.0.0
HTTP_PORT=8901

# ── Мантиқи корӣ ──
