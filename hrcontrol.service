[Unit]
Description=SoftClub HR Control — Telegram bot + admin panel
After=network-online.target
Wants=network-online.target
# Ҳеҷ гоҳ «аз ҳад зиёд restart» ҳисоб намешавад (бояд дар [Unit] бошад, на [Service])
StartLimitIntervalSec=0

[Service]
Type=simple
User=kabir0067
WorkingDirectory=/home/kabir0067/Hrcontrol
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/home/kabir0067/Hrcontrol/.venv/bin/python3 main.py

# Ҳеҷ гоҳ намемирад: ҳар афтиш → аз нав (5с → … → то 60с, агар пай дар пай афтад)
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60

# Хомӯшшавии осоишта: main.py SIGTERM-ро мегирад ва дар ≤10 сония мебарояд
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hrcontrol

[Install]
WantedBy=multi-user.target
